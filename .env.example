# Скопировать в .env и заполнить реальными значениями:
#   cp .env.example .env
# .env не должен попадать в git — он уже в .gitignore.

# Пользователь и БД, которые создаст официальный образ postgres при первом
# запуске (это база n8n_db — служебная база n8n, см. ЭКСПЛУАТАЦИЯ.md §2).
# База legal_db создаётся отдельно скриптом db/init.sql при первом старте
# и подключается тем же пользователем/паролем.
POSTGRES_USER=legal_admin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=n8n_db

# Ключ шифрования credentials n8n. Сгенерировать один раз:
#   openssl rand -hex 32
# ВАЖНО: потеря этого ключа делает все сохранённые credentials в n8n нечитаемыми.
# Хранить резервную копию .env отдельно от сервера.
N8N_ENCRYPTION_KEY=change-me
